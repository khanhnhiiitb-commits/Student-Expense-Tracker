<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/screen_bg" android:orientation="vertical" android:padding="20dp">
    <!--  Thẻ thông tin người dùng  -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:background="@drawable/bg_card" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="28dp" android:paddingEnd="20dp" android:paddingBottom="28dp">
        <!--  Avatar mặc định  -->
        <ImageView android:layout_width="96dp" android:layout_height="96dp" android:background="@drawable/bg_avatar_circle" android:padding="24dp" android:src="@drawable/ic_person" app:tint="@color/primary"/>
        <!--  Tên người dùng  -->
        <TextView android:id="@+id/tvProfileName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Tên người dùng" android:textColor="@color/text_main" android:textSize="22sp" android:textStyle="bold"/>
        <!--  Email người dùng  -->
        <TextView android:id="@+id/tvProfileEmail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="email@example.com" android:textColor="@color/text_sub" android:textSize="14sp"/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnEditProfile" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:text="Chỉnh sửa họ tên" android:textAllCaps="false" android:textSize="15sp" app:backgroundTint="@color/primary" app:cornerRadius="14dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnChangePassword" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="Đổi mật khẩu" android:textAllCaps="false" android:textColor="@color/primary" android:textSize="15sp" app:backgroundTint="@color/info_bg" app:cornerRadius="14dp"/>
    <!--  Đẩy nút Đăng xuất xuống cuối màn hình  -->
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <!--  Nút Đăng xuất  -->
    <com.google.android.material.button.MaterialButton android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="16dp" android:text="Đăng xuất" android:textAllCaps="false" android:textColor="#EF4444" android:textSize="15sp" android:textStyle="bold" app:backgroundTint="#FEF2F2" app:cornerRadius="14dp" app:strokeColor="#FCA5A5" app:strokeWidth="1dp"/>
</LinearLayout>