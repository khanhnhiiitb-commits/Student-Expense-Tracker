<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_item_transaction"
    android:elevation="1dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <!-- Khung icon danh mục bo góc 14dp -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icon_clip"
        android:clipToOutline="true">

        <TextView
            android:id="@+id/tvCategoryIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.88"
            android:background="#EFF6FF"
            android:gravity="center"
            android:text="📦"
            android:textSize="17sp" />
    </FrameLayout>

    <!-- Tên và phân loại danh mục -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCategoryName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ăn uống"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCategorySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Mặc định · Cố định hệ thống"
            android:textColor="#64748B"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Nút Sửa (Vector bút nét mảnh) -->
    <TextView
        android:id="@+id/btnEditCategory"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/ic_btn_edit_category"
        android:gravity="center"
        android:text="" />

    <!-- Nút Xóa (Vector thùng rác nét mảnh) -->
    <TextView
        android:id="@+id/btnDeleteCategory"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/ic_btn_delete_category"
        android:gravity="center"
        android:text="" />

</LinearLayout>