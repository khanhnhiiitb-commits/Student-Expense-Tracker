<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_rounded"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Khung bo góc: Java tô màu nền tvCategoryIcon, khung này cắt theo bo góc -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_icon_clip"
        android:clipToOutline="true">

        <TextView
            android:id="@+id/tvCategoryIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="📦"
            android:textSize="22sp" />
    </FrameLayout>

    <!-- Tên và phân loại danh mục -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCategoryName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ăn uống"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCategorySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Mặc định · Cố định hệ thống"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Ô nhập hạn mức -->
    <EditText
        android:id="@+id/edtBudgetAmount"
        android:layout_width="120dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical|end"
        android:hint="0"
        android:inputType="number"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/text_main"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp" />

</LinearLayout>
