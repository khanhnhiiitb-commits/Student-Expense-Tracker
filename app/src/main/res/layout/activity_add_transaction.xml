<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- 1. Header Bar -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#E2E8F0"
            android:contentDescription="Đóng"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#475569" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Thêm giao dịch"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. Nút Lưu giao dịch ở đáy màn hình -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSaveTransaction"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:background="#0284C7"
        android:stateListAnimator="@null"
        android:text="Lưu giao dịch"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 3. Khu vực cuộn nội dung ở giữa -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/btnSaveTransaction"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- Tab Chi tiêu / Thu nhập -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="#E2E8F0"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tabExpense"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:text="↗ Chi tiêu"
                    android:textColor="#0284C7"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabIncome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="↙ Thu nhập"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tiền hiển thị -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="SỐ TIỀN GIAO DỊCH"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="35.000"
                    android:textColor="#0F172A"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="đ"
                    android:textColor="#0284C7"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Bàn phím số -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="3">

                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="1" android:textColor="#0F172A" android:textSize="22sp" />
                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="2" android:textColor="#0F172A" android:textSize="22sp" />
                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="3" android:textColor="#0F172A" android:textSize="22sp" />

                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="4" android:textColor="#0F172A" android:textSize="22sp" />
                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="5" android:textColor="#0F172A" android:textSize="22sp" />
                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="6" android:textColor="#0F172A" android:textSize="22sp" />

                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="7" android:textColor="#0F172A" android:textSize="22sp" />
                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="8" android:textColor="#0F172A" android:textSize="22sp" />
                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="9" android:textColor="#0F172A" android:textSize="22sp" />

                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="000" android:textColor="#0F172A" android:textSize="18sp" />
                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="0" android:textColor="#0F172A" android:textSize="22sp" />
                <TextView android:id="@+id/btnBackspace" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="⌫" android:textColor="#0F172A" android:textSize="22sp" android:textStyle="bold" />
            </GridLayout>

            <!-- Tiêu đề Danh mục -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Danh mục"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnViewAllCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Xem tất cả"
                    android:textColor="#0284C7"
                    android:textSize="13sp" />
            </RelativeLayout>

            <!-- Lưới Danh mục -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4">

                <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:background="#E0F2FE" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="#0284C7" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Ăn uống" android:textColor="#0284C7" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:background="#FFFFFF" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_directions" app:tint="#D97706" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Đi lại" android:textColor="#334155" android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:background="#FFFFFF" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_agenda" app:tint="#059669" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Học tập" android:textColor="#334155" android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:background="#FFFFFF" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_manage" app:tint="#7C3AED" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Nhà trọ" android:textColor="#334155" android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:background="#FFFFFF" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_gallery" app:tint="#DB2777" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Mua sắm" android:textColor="#334155" android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:background="#FFFFFF" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_edit" app:tint="#CA8A04" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Hóa đơn" android:textColor="#334155" android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:background="#FFFFFF" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_media_play" app:tint="#9333EA" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Giải trí" android:textColor="#334155" android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:background="#FFFFFF" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_more" app:tint="#64748B" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Khác" android:textColor="#334155" android:textSize="11sp" />
                </LinearLayout>
            </GridLayout>

            <!-- Card thông tin chi tiết -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#FFFFFF"
                android:orientation="vertical">

                <!-- Thời gian -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_today"
                        app:tint="#0284C7" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Thời gian"
                        android:textColor="#64748B"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Hôm nay, 25/10/2026"
                        android:textColor="#0F172A"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#94A3B8"
                        android:textSize="20sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F1F5F9" />

                <!-- Nguồn tiền -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_save"
                        app:tint="#0284C7" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Nguồn tiền"
                        android:textColor="#64748B"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Tài khoản ngân hàng"
                        android:textColor="#0F172A"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#94A3B8"
                        android:textSize="20sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F1F5F9" />

                <!-- Ghi chú -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_info_details"
                        app:tint="#0284C7" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Ghi chú"
                        android:textColor="#64748B"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Bữa trưa tại căn tin"
                        android:textColor="#0F172A"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>