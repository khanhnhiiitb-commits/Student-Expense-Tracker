<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Header Bar -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#E2E8F0"
            android:gravity="center"
            android:text="✕"
            android:textColor="#475569"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Thêm giao dịch"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Nút Lưu giao dịch ở đáy màn hình -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSaveTransaction"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:background="#2563EB"
        android:stateListAnimator="@null"
        android:text="Lưu giao dịch"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Khu vực cuộn form nhập liệu -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/btnSaveTransaction"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- R01: Phân loại giao dịch (Expense / Income) -->
            <LinearLayout
                android:id="@+id/layoutTabs"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="#E2E8F0"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tabExpense"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:text="↗ Chi tiêu"
                    android:textColor="#2563EB"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabIncome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="↙ Thu nhập"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- R03: Số tiền giao dịch (> 0) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="SỐ TIỀN GIAO DỊCH"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="35.000"
                    android:textColor="#0F172A"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="đ"
                    android:textColor="#2563EB"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Bàn phím số -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="3">

                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="1" android:textColor="#0F172A" android:textSize="22sp" />
                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="2" android:textColor="#0F172A" android:textSize="22sp" />
                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="3" android:textColor="#0F172A" android:textSize="22sp" />

                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="4" android:textColor="#0F172A" android:textSize="22sp" />
                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="5" android:textColor="#0F172A" android:textSize="22sp" />
                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="6" android:textColor="#0F172A" android:textSize="22sp" />

                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="7" android:textColor="#0F172A" android:textSize="22sp" />
                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="8" android:textColor="#0F172A" android:textSize="22sp" />
                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="9" android:textColor="#0F172A" android:textSize="22sp" />

                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="000" android:textColor="#0F172A" android:textSize="18sp" />
                <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="0" android:textColor="#0F172A" android:textSize="22sp" />
                <TextView android:id="@+id/btnBackspace" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:gravity="center" android:text="⌫" android:textColor="#0F172A" android:textSize="22sp" android:textStyle="bold" />
            </GridLayout>

            <!-- R02: Chọn danh mục phù hợp (Lưới 9 danh mục chi tiêu theo SP3-03.1) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Danh mục chi tiêu"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnViewAllCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Xem tất cả"
                    android:textColor="#2563EB"
                    android:textSize="13sp" />
            </RelativeLayout>

            <!-- Lưới hiển thị danh mục theo đúng bảng 2.2 -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3">

                <!-- 1. Ăn uống (Đang chọn) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="#DBEAFE"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🍜" android:textSize="20sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Ăn uống" android:textColor="#2563EB" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- 2. Học tập -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📚" android:textSize="20sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Học tập" android:textColor="#334155" android:textSize="11sp" />
                </LinearLayout>

                <!-- 3. Đi lại -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚌" android:textSize="20sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Đi lại" android:textColor="#334155" android:textSize="11sp" />
                </LinearLayout>

                <!-- 4. Nhà ở -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏠" android:textSize="20sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Nhà ở" android:textColor="#334155" android:textSize="11sp" />
                </LinearLayout>

                <!-- 5. Mua sắm -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛍️" android:textSize="20sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Mua sắm" android:textColor="#334155" android:textSize="11sp" />
                </LinearLayout>

                <!-- 6. Giải trí -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎮" android:textSize="20sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Giải trí" android:textColor="#334155" android:textSize="11sp" />
                </LinearLayout>

                <!-- 7. Sức khỏe -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💊" android:textSize="20sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Sức khỏe" android:textColor="#334155" android:textSize="11sp" />
                </LinearLayout>

                <!-- 8. Hóa đơn và dịch vụ -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🧾" android:textSize="20sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Hóa đơn &amp; DV" android:textColor="#334155" android:textSize="11sp" />
                </LinearLayout>

                <!-- 9. Chi tiêu khác -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📦" android:textSize="20sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Chi tiêu khác" android:textColor="#334155" android:textSize="11sp" />
                </LinearLayout>
            </GridLayout>

            <!-- Card thông tin chi tiết (R04: Ngày giao dịch, R05: Ghi chú) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#FFFFFF"
                android:orientation="vertical">

                <!-- R04: Ngày giao dịch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Ngày giao dịch"
                        android:textColor="#64748B"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvTransactionDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Hôm nay, 25/10/2026"
                        android:textColor="#0F172A"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#94A3B8"
                        android:textSize="20sp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                <!-- R05: Ghi chú giao dịch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📝"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Ghi chú"
                        android:textColor="#64748B"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edtTransactionNote"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:gravity="end"
                        android:hint="Nhập ghi chú (tối đa 255 ký tự)"
                        android:maxLength="255"
                        android:singleLine="true"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>