<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- 1. Header -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#E2E8F0"
            android:gravity="center"
            android:text="✕"
            android:textColor="#475569"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Thêm giao dịch"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. Nút Lưu giao dịch -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSaveTransaction"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:background="#2563EB"
        android:text="Lưu giao dịch"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 3. Khu vực cuộn chính -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnSaveTransaction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <!-- Tabs -->
            <LinearLayout
                android:id="@+id/layoutTabs"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="#E2E8F0"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tabExpense"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:text="↗ Chi tiêu"
                    android:textColor="#2563EB"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabIncome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="↙ Thu nhập"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tiền -->
            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="0 đ"
                android:textColor="#2563EB"
                android:textSize="36sp"
                android:textStyle="bold" />

            <!-- Bàn phím số -->
            <GridLayout
                android:id="@+id/layoutKeypad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="3">

                <TextView android:id="@+id/btnNum1" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:background="?android:attr/selectableItemBackground" android:gravity="center" android:text="1" android:textColor="#0F172A" android:textSize="22sp"/>
                <TextView android:id="@+id/btnNum2" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:background="?android:attr/selectableItemBackground" android:gravity="center" android:text="2" android:textColor="#0F172A" android:textSize="22sp"/>
                <TextView android:id="@+id/btnNum3" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:background="?android:attr/selectableItemBackground" android:gravity="center" android:text="3" android:textColor="#0F172A" android:textSize="22sp"/>

                <TextView android:id="@+id/btnNum4" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:background="?android:attr/selectableItemBackground" android:gravity="center" android:text="4" android:textColor="#0F172A" android:textSize="22sp"/>
                <TextView android:id="@+id/btnNum5" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:background="?android:attr/selectableItemBackground" android:gravity="center" android:text="5" android:textColor="#0F172A" android:textSize="22sp"/>
                <TextView android:id="@+id/btnNum6" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:background="?android:attr/selectableItemBackground" android:gravity="center" android:text="6" android:textColor="#0F172A" android:textSize="22sp"/>

                <TextView android:id="@+id/btnNum7" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:background="?android:attr/selectableItemBackground" android:gravity="center" android:text="7" android:textColor="#0F172A" android:textSize="22sp"/>
                <TextView android:id="@+id/btnNum8" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:background="?android:attr/selectableItemBackground" android:gravity="center" android:text="8" android:textColor="#0F172A" android:textSize="22sp"/>
                <TextView android:id="@+id/btnNum9" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:background="?android:attr/selectableItemBackground" android:gravity="center" android:text="9" android:textColor="#0F172A" android:textSize="22sp"/>

                <TextView android:id="@+id/btnNum000" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:background="?android:attr/selectableItemBackground" android:gravity="center" android:text="000" android:textColor="#0F172A" android:textSize="18sp"/>
                <TextView android:id="@+id/btnNum0" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:background="?android:attr/selectableItemBackground" android:gravity="center" android:text="0" android:textColor="#0F172A" android:textSize="22sp"/>
                <TextView android:id="@+id/btnBackspace" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:background="?android:attr/selectableItemBackground" android:gravity="center" android:text="⌫" android:textColor="#0F172A" android:textSize="22sp" android:textStyle="bold" />
            </GridLayout>

            <!-- Chọn danh mục -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Danh mục"
                android:textColor="#0F172A"
                android:textStyle="bold" />

            <!-- RecyclerView cho chọn danh mục -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvTransactionCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="4" />

            <!-- Chọn ngày & Ghi chú -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#FFFFFF"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/btnSelectDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ngày giao dịch"
                        android:textColor="#64748B" />

                    <TextView
                        android:id="@+id/tvTransactionDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Hôm nay"
                        android:textColor="#0F172A" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F1F5F9" />

                <EditText
                    android:id="@+id/edtTransactionNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Nhập ghi chú"
                    android:padding="14dp"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>