<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Khoảng thời gian báo cáo"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/btnCancelRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Hủy"
            android:textColor="@color/primary"
            android:textSize="13sp"/>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_tab_container"
        android:orientation="horizontal"
        android:padding="3dp">
        <TextView
            android:id="@+id/tabThisWeek"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Tuần này"
            android:textColor="@color/text_sub"
            android:textSize="13sp"/>
        <TextView
            android:id="@+id/tabThisMonth"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Tháng này"
            android:textColor="@color/text_sub"
            android:textSize="13sp"/>
        <TextView
            android:id="@+id/tabCustom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selected"
            android:gravity="center"
            android:text="Tùy chọn"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Từ ngày"
        android:textColor="@color/text_main"
        android:textSize="12sp"/>
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:endIconDrawable="@drawable/ic_calendar"
        app:endIconMode="custom">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtFromDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:hint="dd/MM/yyyy"
            android:inputType="none"
            android:textSize="13sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Đến ngày"
        android:textColor="@color/text_main"
        android:textSize="12sp"/>
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:endIconDrawable="@drawable/ic_calendar"
        app:endIconMode="custom">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtToDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:hint="dd/MM/yyyy"
            android:inputType="none"
            android:textSize="13sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Báo cáo gồm cả ngày bắt đầu và kết thúc. Dữ liệu được tổng hợp theo ngày giao dịch."
        android:textColor="@color/text_sub"
        android:textSize="11sp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyRange"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/primary"
        android:text="Xem báo cáo"
        app:cornerRadius="10dp"/>
</LinearLayout>