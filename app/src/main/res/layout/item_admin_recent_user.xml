<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <!-- Avatar chữ cái viết tắt (VD: TL, QB) -->
    <TextView
        android:id="@+id/tvUserInitials"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_circle_gray"
        android:gravity="center"
        android:text="SV"
        android:textColor="#334155"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Họ tên & Email / MSSV -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRecentUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tên sinh viên"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRecentUserMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="sinhvien@ueh.edu.vn"
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Nhãn trạng thái: Hoạt động (bg_soft_green) / Đã khóa (bg_soft_red) -->
    <TextView
        android:id="@+id/tvRecentUserStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_soft_green"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="Hoạt động"
        android:textColor="#15803D"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>