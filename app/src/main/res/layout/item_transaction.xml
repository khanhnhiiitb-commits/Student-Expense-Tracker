<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="12dp"
    android:paddingHorizontal="16dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Icon nền tròn chứa Emoji danh mục -->
    <TextView
        android:id="@+id/tvTransactionIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="#F1F5F9"
        android:gravity="center"
        android:text="💸"
        android:textSize="20sp" />

    <!-- Thông tin tên danh mục / ghi chú và ngày -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTransactionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ăn uống"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTransactionDateNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="25/10/2026 · Cơm trưa"
            android:textColor="#64748B"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Số tiền hiển thị (+ hoặc - kèm màu xanh lá / đỏ) -->
    <TextView
        android:id="@+id/tvTransactionAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="- 35.000 đ"
        android:textColor="#EF4444"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>