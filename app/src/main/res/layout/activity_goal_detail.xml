<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_back"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Chi tiết mục tiêu"
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvGoalName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Laptop học tập"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressGoal"
                android:layout_width="181dp"
                android:layout_height="match_parent"
                android:max="100"
                android:progress="40"
                app:indicatorColor="@color/primary"
                app:indicatorSize="160dp"
                app:trackColor="#E5E7EB"
                app:trackThickness="10dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvGoalPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="40%"
                    android:textColor="@color/primary"
                    android:textSize="28sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="đã hoàn thành"
                    android:textColor="@color/text_sub"
                    android:textSize="10sp"/>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đã tích lũy" android:textColor="@color/text_sub" android:textSize="12sp"/>
                <TextView android:id="@+id/tvSaved" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="0 đ" android:textColor="@color/text_main" android:textSize="12sp" android:textStyle="bold"/>
            </RelativeLayout>
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Số tiền cần đạt" android:textColor="@color/text_sub" android:textSize="12sp"/>
                <TextView android:id="@+id/tvTarget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="0 đ" android:textColor="@color/text_main" android:textSize="12sp" android:textStyle="bold"/>
            </RelativeLayout>
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Còn cần tích lũy" android:textColor="@color/text_sub" android:textSize="12sp"/>
                <TextView android:id="@+id/tvRemaining" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="0 đ" android:textColor="@color/text_main" android:textSize="12sp" android:textStyle="bold"/>
            </RelativeLayout>
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hạn chót" android:textColor="@color/text_sub" android:textSize="12sp"/>
                <TextView android:id="@+id/tvDeadline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="--/--/----" android:textColor="@color/text_main" android:textSize="12sp" android:textStyle="bold"/>
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_info_box"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:id="@+id/tvStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bạn đang đi đúng hướng"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvStatusMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Mỗi khoản tích lũy nhỏ đều giúp bạn tiến gần hơn đến chiếc laptop mới."
                android:textColor="@color/primary"
                android:textSize="11sp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateGoal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/primary"
            android:text="Cập nhật mục tiêu"
            app:cornerRadius="10dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToList"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Quay lại danh sách"
            android:textColor="@color/primary"
            app:cornerRadius="10dp"
            app:strokeColor="@color/primary"/>
    </LinearLayout>
</ScrollView>