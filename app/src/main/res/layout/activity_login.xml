<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Gradient UEH Finance -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_ueh"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="68dp">

            <!-- Hàng trên cùng: Badge UEH FINANCE + Nút tròn góc phải -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_pill_glass"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="🎓  UEH FINANCE"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_pill_glass"
                    android:gravity="center"
                    android:text="☀"
                    android:textColor="@android:color/white"
                    android:textSize="15sp" />
            </RelativeLayout>

            <!-- Logo tròn & Tiêu đề chính -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/bg_pill_glass"
                    android:padding="5dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_logo_circle"
                        android:elevation="4dp"
                        android:gravity="center"
                        android:text="💰"
                        android:textSize="32sp" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Chi tiêu cá nhân"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Mỗi đồng, một kế hoạch."
                    android:textColor="#DBEAFE"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Thẻ Form Đăng nhập nổi đè lên Header -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="-42dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chào mừng trở lại!"
                    android:textColor="#0F172A"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="20dp"
                    android:text="Đăng nhập để tiếp tục theo dõi chi tiêu và kế hoạch tài chính."
                    android:textColor="#64748B"
                    android:textSize="13sp" />

                <!-- EMAIL SINH VIÊN -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:letterSpacing="0.04"
                    android:text="EMAIL SINH VIÊN"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtLoginEmail"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_soft"
                    android:drawableStart="@drawable/ic_mail_outline"
                    android:drawablePadding="10dp"
                    android:hint="sinhvien@ueh.edu.vn"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="14dp"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

                <!-- MẬT KHẨU -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:letterSpacing="0.04"
                    android:text="MẬT KHẨU"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="#64748B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtLoginPassword"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_input_soft"
                        android:drawableStart="@drawable/ic_lock_outline"
                        android:drawablePadding="10dp"
                        android:hint="Nhập mật khẩu"
                        android:inputType="textPassword"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Ghi nhớ & Quên mật khẩu -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp">

                    <CheckBox
                        android:id="@+id/cbRememberMe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:buttonTint="#1D4ED8"
                        android:text="Ghi nhớ đăng nhập"
                        android:textColor="#475569"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvForgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:padding="6dp"
                        android:text="Quên mật khẩu?"
                        android:textColor="#1D4ED8"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Nút Đăng nhập -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Đăng nhập  →"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="#0047AB"
                    app:cornerRadius="14dp"
                    app:elevation="2dp" />

                <!-- Ngăn cách HOẶC -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#E2E8F0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:text="HOẶC"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#E2E8F0" />
                </LinearLayout>

                <!-- Nút Tiếp tục với Google -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoogleLogin"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Tiếp tục với Google"
                    android:textAllCaps="false"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@android:color/white"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_google_g"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconTint="@null"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Thẻ Bảo mật tài khoản sinh viên UEH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_security_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_shield_check" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bảo mật tài khoản sinh viên UEH"
                    android:textColor="#0F172A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Dữ liệu mã hóa an toàn đa lớp"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Footer Đăng ký -->
        <TextView
            android:id="@+id/tvGoToRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:padding="8dp"
            android:text="Chưa có tài khoản? Đăng ký ngay"
            android:textColor="#1D4ED8"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>